# Public DNS name resolving to the Docker host; not a GitHub Pages domain.
API_DOMAIN=dashboard-api.example.com
# Exact GitHub Pages URL, ideally a dedicated custom domain to isolate sessions.
FRONTEND_URL=https://moritzbrantner.github.io/repo-dashboard/
# Create a GitHub OAuth App with callback https://<API_DOMAIN>/auth/callback.
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
